# Database (PostgreSQL)
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_password
POSTGRES_DB=aiops_db
DATABASE_URL=postgresql+asyncpg://aiops:aiops_password@postgres:5432/aiops_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Microservice URLs
API_BASE_URL=http://api:8000
AI_WORKER_URL=http://ai-worker:8001
WEB_PORT=3000

# GenAI & LLM Configuration (Rudra - AI/RAG Lead)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
FALLBACK_MODE=deterministic

# SRE & Telemetry
LOG_LEVEL=INFO
ENVIRONMENT=development
